#!/bin/sh
set -eu

url=${1:-http://127.0.0.1:7777/api/v1/health}
attempt=0
while [ "$attempt" -lt 50 ]; do
  if command -v curl >/dev/null 2>&1 && curl --fail --silent --show-error "$url" >/dev/null; then
    exit 0
  fi
  if command -v wget >/dev/null 2>&1 && wget --quiet --output-document=/dev/null "$url"; then
    exit 0
  fi
  attempt=$((attempt + 1))
  sleep 0.2
done

echo "Control Room health check did not become ready at $url" >&2
exit 1
